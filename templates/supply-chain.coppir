  "injects": {
   "advisory": {
    "id": "advisory",
    "title": "Vendor security advisory",
    "body": "The vendor says version 2026.4.1 'may contain unauthorised code'. No details yet.",
    "severity": "warning",
    "audience": {
     "mode": "all"
    },
    "effects": [
     {
      "type": "set_status",
